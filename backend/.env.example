# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env.
# Database lokal:
DATABASE_URL=postgres://postgres:PASSWORDMU@localhost:5432/pengaduan_desa
# Database cloud (Neon / Supabase) — tempel connection string dari dasbornya:
# DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Teks acak panjang (min. 32 karakter). Wajib diisi di production.
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
PORT=4000
